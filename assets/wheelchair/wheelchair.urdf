<?xml version="1.0"?>
<!--
  Minimal placeholder wheelchair for the Tier 2/3 stretch task (spec §5.5).

  "2 driven wheels + 2 offset-caster front wheels is enough to validate the
  reward logic; visual fidelity doesn't matter yet." Rear wheels are driven
  revolute joints (free-spinning here -- the robot pushes the chassis, it
  isn't self-propelled); front casters are revolute-about-z pivots with a
  physical trail offset before the wheel axle, which is what makes a caster
  self-align to the direction of travel instead of sliding "like a block of
  ice" (spec's exact framing).
-->
<robot name="wheelchair">

  <material name="chair_blue"><color rgba="0.2 0.35 0.75 1.0"/></material>
  <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="chassis">
    <inertial>
      <mass value="12.0"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.9" iyz="0" izz="0.5"/>
    </inertial>
    <visual>
      <geometry><box size="0.55 0.5 0.4"/></geometry>
      <material name="chair_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.55 0.5 0.4"/></geometry>
    </collision>
  </link>

  <!-- Push handle -- the grasp target grasp_attach.py's attach() welds to. -->
  <link name="handle">
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.015" length="0.35"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.015" length="0.35"/></geometry></collision>
  </link>
  <joint name="handle_fixed" type="fixed">
    <parent link="chassis"/><child link="handle"/>
    <origin xyz="-0.28 0 0.45" rpy="1.5708 0 0"/>
  </joint>

  <!-- Rear driven wheels (large, main rolling wheels). Free-spinning: no
       motor target is set in wheelchair_task.py, only damping/friction. -->
  <link name="rear_left_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><cylinder radius="0.12" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.04"/></geometry></collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/><child link="rear_left_wheel"/>
    <origin xyz="-0.2 0.27 -0.18" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="rear_right_wheel">
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><geometry><cylinder radius="0.12" length="0.04"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.12" length="0.04"/></geometry></collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/><child link="rear_right_wheel"/>
    <origin xyz="-0.2 -0.27 -0.18" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Front casters: pivot (revolute about vertical z) -> trail offset ->
       small free wheel. The trail offset (0.04 m forward of the pivot) is
       what lets the caster self-align to travel direction under physics. -->
  <link name="front_left_caster_pivot">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.01" length="0.06"/></geometry><material name="wheel_black"/></visual>
  </link>
  <joint name="front_left_caster_pivot_joint" type="continuous">
    <parent link="chassis"/><child link="front_left_caster_pivot"/>
    <origin xyz="0.24 0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="front_left_wheel">
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.06" length="0.03"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_caster_pivot"/><child link="front_left_wheel"/>
    <origin xyz="0.04 0 -0.06" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="front_right_caster_pivot">
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.01" length="0.06"/></geometry><material name="wheel_black"/></visual>
  </link>
  <joint name="front_right_caster_pivot_joint" type="continuous">
    <parent link="chassis"/><child link="front_right_caster_pivot"/>
    <origin xyz="0.24 -0.2 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="front_right_wheel">
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.06" length="0.03"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_caster_pivot"/><child link="front_right_wheel"/>
    <origin xyz="0.04 0 -0.06" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

</robot>
