<?xml version="1.0"?>
<!--
  Throwaway stand-in robot for testing the Step 3 teleop chain tonight,
  before Step 2's real PyBullet prototype (and, tomorrow, the real
  ridgeback_franka.usd in Isaac Sim) exist. Visual/dimensional accuracy
  deliberately does not matter here -- see master doc Part 5.4: "you're
  validating reward logic and constraint behavior, not producing a demo
  asset." This is the Step-3-side equivalent: validating that RobotAction
  actually drives *something* visible, nothing more.

  Loaded with useFixedBase=False, so base_link is a free-floating 6-DOF
  root; base_velocity is applied directly to it. shoulder/elbow are a
  2-DOF arm stand-in driven by IK toward arm_target_pose. finger_left/
  finger_right are a toy 2-finger gripper driven open/closed.
-->
<robot name="toy_teleop_robot">

  <material name="body_gray">
    <color rgba="0.5 0.5 0.55 1"/>
  </material>
  <material name="arm_orange">
    <color rgba="0.9 0.5 0.1 1"/>
  </material>
  <material name="gripper_dark">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.5 0.4 0.2"/></geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <geometry><box size="0.5 0.4 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.6"/>
    </inertial>
  </link>

  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0.1 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="50" velocity="2.0"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.2"/></geometry>
      <material name="arm_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="2.0"/>
  </joint>

  <link name="hand">
    <visual>
      <geometry><box size="0.06 0.08 0.03"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.08 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="wrist" type="fixed">
    <parent link="forearm"/>
    <child link="hand"/>
    <origin xyz="0 0 0.2" rpy="0 1.5708 0"/>
  </joint>

  <link name="finger_left">
    <visual>
      <geometry><box size="0.015 0.02 0.05"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.015 0.02 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="finger_left_joint" type="prismatic">
    <parent link="hand"/>
    <child link="finger_left"/>
    <origin xyz="0 0.02 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="1.0"/>
  </joint>

  <link name="finger_right">
    <visual>
      <geometry><box size="0.015 0.02 0.05"/></geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.015 0.02 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="hand"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.02 0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="1.0"/>
  </joint>

</robot>
