# Teammate 1 only. Paths may also be set in config/mapper.gb10.toml.
SIMBIOTE_SSD_ROOT=/mnt/simbiote-ssd
SIMBIOTE_MODE=production

# Commands are split without a shell. Use executable scripts for complex pipelines.
# Supported placeholders are documented in README.md.
SIMBIOTE_COLMAP_COMMAND=/opt/simbiote/bin/run_colmap.sh {capture} {output}
SIMBIOTE_DEPTH_COMMAND=/opt/simbiote/bin/run_depth.sh {capture} {colmap} {checkpoint} {output}
SIMBIOTE_DGRUT_COMMAND=/opt/simbiote/bin/run_3dgrut.sh {capture} {colmap} {depth} {output}
SIMBIOTE_SAM3_COMMAND=/opt/simbiote/bin/run_sam3.sh {capture} {geometry} {checkpoint} {output}
