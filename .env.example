# Teammate 1 only. Paths may also be set in config/mapper.gb10.toml.
FACTORYFLOW_SSD_ROOT=/mnt/factoryflow-ssd
FACTORYFLOW_MODE=production

# Commands are split without a shell. Use executable scripts for complex pipelines.
# Supported placeholders are documented in README.md.
FACTORYFLOW_COLMAP_COMMAND=/opt/factoryflow/bin/run_colmap.sh {capture} {output}
FACTORYFLOW_DEPTH_COMMAND=/opt/factoryflow/bin/run_depth.sh {capture} {colmap} {checkpoint} {output}
FACTORYFLOW_DGRUT_COMMAND=/opt/factoryflow/bin/run_3dgrut.sh {capture} {colmap} {depth} {output}
FACTORYFLOW_SAM3_COMMAND=/opt/factoryflow/bin/run_sam3.sh {capture} {geometry} {checkpoint} {output}
